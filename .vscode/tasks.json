{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C file",
      "type": "process",
      "command": "gcc",
      "args": [
        "-Wall",
        "-Wextra",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run",
      "type": "process",
      "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "dependsOn": "Build C file",
      "presentation": {
        "reveal": "always",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build (no warnings)",
      "type": "process",
      "command": "gcc",
      "args": ["-g", "${file}", "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build (-O2)",
      "type": "process",
      "command": "gcc",
      "args": ["-Wall", "-Wextra", "-O2", "${file}", "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run only",
      "type": "process",
      "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "presentation": { "reveal": "always", "focus": true, "clear": true },
      "problemMatcher": []
    }
  ]
}